# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated allowlist for CORS + sockets in production, e.g.:
# CORS_ORIGINS=https://eduswap.vercel.app,https://www.eduswap.app
CORS_ORIGINS=

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/eduswap?retryWrites=true&w=majority

# ── JWT (use long random strings in production) ───────────
JWT_ACCESS_SECRET=change_me_dev_access_secret_please
JWT_REFRESH_SECRET=change_me_dev_refresh_secret_please
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (Phase 7) ──────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (Phase 5) ────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EduSwap <no-reply@eduswap.app>"

# ── Rate limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
